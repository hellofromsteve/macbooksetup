{
  "window.openFilesInNewWindow": "off",
  "editor.formatOnSave": true,
  "workbench.iconTheme": "catppuccin-mocha",
  "editor.fontFamily": "'JetBrains Mono', 'Dank Mono', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontSize": 15,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.8,
  "editor.formatOnPaste": true,
  "editor.cursorHeight": 30,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["comment", "keyword", "storage.modifier", "entity.name.type", "variable.language"],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "workbench.settings.applyToAllProfiles": ["editor.fontFamily"],
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.editor.enablePreview": false,
  "editor.minimap.renderCharacters": true,
  "editor.minimap.enabled": false,
  "workbench.tree.indent": 13,
  "git.openRepositoryInParentFolders": "never",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
    "*.dart": "${capture}.g.dart",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "chat.mcp.gallery.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.tools.terminal.autoApprove": {
    "hfstephen\"": true,
    "'EOF'": true,
    "session()-": true,
    "put('hfstephen',": true,
    "'Success',": true,
    "'It": true,
    "'success',": true,
    "'top-right'])": true,
    "has('hfstephen')": true,
    "var_dump(session('hfstephen'))": true,
    "var_dump(Session::now('test',": true,
    "'test']))": true,
    "EOF": true,
    "'Test',": true,
    "'This": true,
    "'top-right',": true,
    "4000,": true,
    "true": true,
    "//": true,
    "$output": true,
    "render()": true,
    "}": true,
    "getMessage()": true,
    "composer": true,
    "php artisan tinker": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^php artisan route:clear && php artisan config:clear && php artisan cache:clear && php artisan optimize:clear$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^php artisan optimize:clear$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "./vendor/bin/phpunit": true,
    "vendor/bin/phpunit": true
  },
  "liveServer.settings.donotVerifyTags": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "http.systemCertificatesNode": true,
  "Laravel.phpEnvironment": "herd",
  "Laravel.pint.runOnSave": true,
  "workbench.startupEditor": "none",
  "vscode_custom_css.imports": [
    "file:///Users/stephen/Apps/Other/setup/vscode.css",
    "file:///Users/stephen/Apps/Other/setup/vscode.js"
  ],
  "workbench.tree.enableStickyScroll": false,
  "geminicodeassist.displayInlineContextHint": false,
  "atlascode.rovodev.showEntitlementNotifications": false,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.formatOnSave": true
  },
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter"
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  },
  "laravel-pint.executable": "./vendor/bin/pint",
  "workbench.statusBar.visible": false,
  "chat.commandCenter.enabled": false,
  "emmet.includeLanguages": {
    "blade": "html",
    "vue-html": "html",
    "html": "html"
  },
  "emmet.triggerExpansionOnTab": true,
  "tailwindCSS.emmetCompletions": true,
  "namespaceResolver.showMessageOnStatusBar": true,
  "namespaceResolver.highlightOnSave": true,
  "namespaceResolver.sortOnSave": true,
  "namespaceResolver.sortNatural": true,
  "namespaceResolver.sortAlphabetically": true,
  "prettier.bracketSpacing": false,
  "prettier.printWidth": 120,
  "notebook.defaultFormatter": "esbenp.prettier-vscode",
  "editor.wordWrapColumn": 120,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "workbench.activityBar.location": "top",
  "geminicodeassist.project": "cryptic-legend-c0x44",
  "prettier.bracketSameLine": true,
  "workbench.sideBar.location": "right",
  "laravel-pint.enableDebugLogs": true,
  "laravel-pint.preset": "laravel",
  "laravel-pint.runInLaravelSail": true,
  "laravel-pint.enable": true,
  "chat.viewSessions.orientation": "stacked",
  "editor.largeFileOptimizations": false,
  "editor.accessibilitySupport": "on",
  "workbench.layoutControl.enabled": false,
