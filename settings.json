
{
    "window.openFilesInNewWindow": "on",
    "laravel-pint.enable": true,
    "editor.formatOnSave": true,
    "workbench.iconTheme": "catppuccin-frappe",
    "workbench.colorTheme": "Catppuccin Frappé",
    "editor.fontFamily": "'JetBrains Mono', 'Dank Mono', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.6,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "keyword",
                    "storage.modifier",
                    "entity.name.type",
                    "variable.language"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            }
        ]
    },
    "workbench.settings.applyToAllProfiles": [
        "editor.fontFamily"
    ],
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.editor.enablePreview": false,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.enabled": false,
    "workbench.tree.indent": 13,
    "git.openRepositoryInParentFolders": "never",
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
        "*.dart": "${capture}.g.dart",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "chat.mcp.gallery.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.tools.terminal.autoApprove": {
        "hfstephen\"": true,
        "'EOF'": true,
        "session()-": true,
        "put('hfstephen',": true,
        "'Success',": true,
        "'It": true,
        "'success',": true,
        "'top-right'])": true,
        "has('hfstephen')": true,
        "var_dump(session('hfstephen'))": true,
        "var_dump(Session::now('test',": true,
        "'test']))": true,
        "EOF": true,
        "'Test',": true,
        "'This": true,
        "'top-right',": true,
        "4000,": true,
        "true": true,
        "//": true,
        "$output": true,
        "render()": true,
        "}": true,
        "getMessage()": true,
        "composer": true,
        "php artisan tinker": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^php artisan route:clear && php artisan config:clear && php artisan cache:clear && php artisan optimize:clear$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^php artisan optimize:clear$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "./vendor/bin/phpunit": true,
        "vendor/bin/phpunit": true
    },
    "liveServer.settings.donotVerifyTags": true,
    "liveServer.settings.donotShowInfoMsg": true,
    "[vue]": {
        "editor.defaultFormatter": "Vue.volar"
    },
    "chat.viewSessions.orientation": "stacked",
    "http.systemCertificatesNode": true,
    "geminicodeassist.project": "cryptic-legend-c0x44",
    "Laravel.phpEnvironment": "herd",
    "Laravel.pint.runOnSave": true,
    "workbench.startupEditor": "none",
    "vscode_custom_css.imports": [
        "file:///Users/stephen/Apps/Other/setup/vscode.css",
        "file:///Users/stephen/Apps/Other/setup/vscode.js"
    ],
    "vscode_custom_css.policy": true,
    "workbench.statusBar.visible": false,
    "workbench.tree.enableStickyScroll": false,
}
